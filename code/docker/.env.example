# Production env for docker/compose.yaml.  cp .env.example .env  (in docker/) and edit.
# All model paths are relative to MODELS_DIR (mounted read-only at /models).

# --- images (pinned: llama.cpp release b11176 = newest published Docker build <= b11185, CUDA 12.8)
LLM_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda-b11176
# expected multi-arch index digest of LLM_IMAGE (verified by vm_up.sh after pull)
LLM_IMAGE_DIGEST=sha256:1f4b9cf58982dd4d7cc497aea31b1a456ca9a3a1f94f527d317d3fdee0d60ab6
HARNESS_IMAGE=wmt-harness:latest

# --- data
MODELS_DIR=../models
INDEX_DIR=../kb_data/index

# --- trained model: EITHER base GGUF + LoRA adapter ...
MODEL_FILE=bielik-11b-v3/Bielik-11B-v3.0-Instruct.Q4_K_M.gguf
LORA_FILE=
LORA_SCALE=1.0
# ... OR a merged GGUF (then leave LORA_FILE empty and set BASE_MODEL_FILE to the original GGUF)
MODEL_ALIAS=wmt-trained

# --- untouched base for the benchmark (docker compose --profile base up -d)
#     default = MODEL_FILE without the LoRA
BASE_MODEL_FILE=
BASE_MODEL_ALIAS=base

# --- llama-server
N_GPU_LAYERS=999
CTX_SIZE=16384
N_PARALLEL=4
KV_UNIFIED=1
LLAMA_EXTRA_ARGS=
SEED=

# --- published ports (host side, loopback only)
BIND_ADDR=127.0.0.1
HARNESS_HOST_PORT=18000
RAW_HOST_PORT=18080
