# Env for the Mac CPU smoke test (docker compose --env-file docker/mac.env ...).
# Paths are relative to docker/ (the compose project dir).
MODELS_DIR=../models
MODEL_FILE=smoke/Bielik-1.5B-v3.0-Instruct.Q8_0.gguf
MODEL_ALIAS=smoke-bielik-1.5b
N_GPU_LAYERS=0
CTX_SIZE=8192
N_PARALLEL=2
KV_UNIFIED=1
LLAMA_EXTRA_ARGS=-t 4
INDEX_DIR=../kb_data/index_mini
HARNESS_IMAGE=wmt-harness:latest
# ports 18000/18080 may be used by native dev servers on the shared Mac
HARNESS_HOST_PORT=18050
RAW_HOST_PORT=18051
